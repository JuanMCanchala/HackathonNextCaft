{
  "name": "hackathon-nextcraft-convex-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sentra product Convex backend (distinct from the Python model package in /backend).",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm typecheck",
    "codegen": "convex codegen",
    "dev": "convex dev",
    "seed:bootstrap": "node scripts/run-seed-bootstrap.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@convex-dev/agent": "latest",
    "ai": "latest",
    "convex": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@edge-runtime/vm": "^5.0.0",
    "@types/jest": "latest",
    "@types/node": "latest",
    "babel-jest": "^30.5.0",
    "convex-test": "^0.0.56",
    "cross-env": "^7.0.3",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "jest": "latest",
    "prettier": "latest",
    "ts-jest": "latest",
    "ts-node": "^10.9.2",
    "tsx": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest"
  }
}
