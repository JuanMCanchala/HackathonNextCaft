# Convex CLI uses this URL after `pnpm dev` or `pnpm codegen`.
CONVEX_DEPLOYMENT=

# Required by the OpenAI provider used by the support agent.
OPENAI_API_KEY=

# Clerk → Convex JWT validation.
# This is configuration, not a secret. Set it in .env.local and in the
# Convex deployment environment before running `pnpm dev` or deploying.
CLERK_JWT_ISSUER_DOMAIN=https://premium-humpback-2836.clerk.accounts.dev
# Must match the `aud` claim in Clerk's Convex JWT template.
CLERK_JWT_APPLICATION_ID=convex
