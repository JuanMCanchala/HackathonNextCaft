# Convex CLI uses this URL after `pnpm dev` or `pnpm codegen`.
CONVEX_DEPLOYMENT=

# Required by the OpenAI provider used by the support agent.
OPENAI_API_KEY=

# Clerk → Convex JWT validation (also set these in the Convex dashboard).
# Issuer domain is the Clerk Frontend API URL (https://….clerk.accounts.dev).
CLERK_JWT_ISSUER_DOMAIN=
# JWT `aud` claim; Clerk Convex templates typically use "convex".
CLERK_JWT_APPLICATION_ID=convex
