# Frontend Sentra — variables de entorno (referencia)
# Angular lee de src/environments/environment.ts (no VITE_* automático).
# Si migras a .env, usa fileReplacements o un script de build.

# Clerk (publishable — OK en frontend)
# Dashboard → API Keys → Publishable key
CLERK_PUBLISHABLE_KEY=pk_test_XXXX

# Issuer para Convex (convex-backend/.env.local + dashboard Convex)
CLERK_JWT_ISSUER_DOMAIN=https://TU-INSTANCIA.clerk.accounts.dev
CLERK_JWT_APPLICATION_ID=convex

# Convex (cuando dataSource = convex)
CONVEX_URL=https://XXXX.convex.cloud

# Mock API local (dataSource = http)
SENTRA_API_BASE=http://localhost:3000
