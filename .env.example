# Consigue una key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fuente de video: indice de webcam (0), ruta a archivo, o URL rtsp/http
SENTINEL_SOURCE=0
SENTINEL_DOMAIN=retail_theft
SENTINEL_DEVICE=cuda

# Avisos externos (opcionales). Telegram manda la foto del incidente al movil.
# Crea un bot con @BotFather y saca tu chat id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook generico: vale para Slack, Discord o lo que tengais.
ALERT_WEBHOOK_URL=
